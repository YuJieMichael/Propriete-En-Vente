# Browser-safe Supabase project settings. Never put service_role or secret keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable only after the private intake backend is deployed and tested.
VITE_ENQUIRY_ENABLED=false
# Also requires NDA_REQUESTS_ENABLED=true in submit-enquiry.
VITE_NDA_REQUESTS_ENABLED=false
# Enable after migrations 002/003, submit-listing, and staff review are tested.
VITE_LISTING_PUBLICATION_ENABLED=false

# Empty uses managed Supabase projects; /api uses the Docker project service.
VITE_PROJECT_API_URL=

# Public Google Ads tag ID and conversion labels for this site.
VITE_GOOGLE_ADS_TAG_ID=
VITE_GOOGLE_ADS_BUYER_LABEL=
VITE_GOOGLE_ADS_SELLER_LABEL=
