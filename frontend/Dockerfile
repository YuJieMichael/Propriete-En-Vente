FROM node:22-alpine AS build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
COPY supabase /app/supabase
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_PROJECT_API_URL=/api
ARG VITE_LISTING_PUBLICATION_ENABLED=false
ARG VITE_ENQUIRY_ENABLED=false
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY VITE_PROJECT_API_URL=$VITE_PROJECT_API_URL VITE_LISTING_PUBLICATION_ENABLED=$VITE_LISTING_PUBLICATION_ENABLED VITE_ENQUIRY_ENABLED=$VITE_ENQUIRY_ENABLED
RUN npm run build
FROM nginx:1.28-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80

