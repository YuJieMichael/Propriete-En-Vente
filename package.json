    "test:merge-count": "node --test .github/tests/merge-count.test.mjs",
    "test:backend": "npm --prefix backend test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
