  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev --",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview --",
    "test": "npm run test:ui && npm run test:database && npm run test:functions && npm run test:merge-count",
