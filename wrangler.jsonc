{
  "name": "propriete-en-vente",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "proprieteenvente.ca",
      "custom_domain": true
    },
    {
      "pattern": "www.proprieteenvente.ca",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
